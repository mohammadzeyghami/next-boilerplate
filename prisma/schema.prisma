generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum ProfileRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum StatusAccount {
  ACTIVE
  DEACTIVE
  SUSPEND
}

enum AuthOtpType {
  EMAIL
  PHONE_NUMBER
}

enum AuthValueType {
  Phone
  Email
}

enum ContentAccess {
  PRIVATE
  PUBLIC
}

enum ContentType {
  TEXT
  IMAGE
  VIDEO
  SOUND
  FILE
}

enum UserEventActorType {
  USER
  SYSTEM
}

model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String?              @unique
  emailVerified       DateTime?
  image               String?
  role                UserRole             @default(USER)

  userAuth            UserAuth?
  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  contents            Content[]            @relation("UserContents")
  userEvents          UserEvent[]
  userCredits         UserCredit[]
  userCreditsTimed    UserCreditTimed[]
}

/// Identity + profile (single record per user)
model UserAuth {
  id           String         @id @default(cuid())
  userId       String         @unique
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId     String?        @unique
  username     String?        @unique
  email        String?        @unique
  phoneNumber  String?        @unique
  passwordHash String?
  isGuest      Boolean        @default(false)
  inviteCode   String         @unique
  inviterId    String?
  status       StatusAccount  @default(ACTIVE)

  name         String?
  profileRole  ProfileRole    @default(USER)

  lastName     String?
  born         DateTime?
  metadata     Json?
  contentIds   String[]       @default([])
  firebaseId   String?        @unique
  steamId      String?        @unique

  inviter      UserAuth?      @relation("UserInvites", fields: [inviterId], references: [id], onDelete: SetNull)
  invitees     UserAuth[]     @relation("UserInvites")
  refreshTokens RefreshToken[]

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([email])
  @@index([phoneNumber])
  @@index([username])
  @@index([deviceId])
}

model RefreshToken {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userAuthId String
  userAuth   UserAuth @relation(fields: [userAuthId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userAuthId])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  description String?
  label       String?
  metadata    Json?
  contentIds  String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model Content {
  id         String         @id @default(cuid())
  name       String
  ownerId    String
  text       String?        @db.Text
  access     ContentAccess  @default(PRIVATE)
  metadata   Json?
  contentUrl String?
  type       ContentType
  isEarnable Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  owner      User           @relation("UserContents", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@index([access, createdAt])
  @@index([type, createdAt])
}

model Language {
  id          String   @id @default(cuid())
  name        String
  description String?
  contentIds  String[] @default([])
  categoryIds String[] @default([])
  tagIds      String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

/// Maps to table "Tag"; model name yields `prisma.contentTag` (avoids fragile `prisma.tag` in dev).
model ContentTag {
  id          String   @id @default(cuid())
  name        String
  description String?
  label       String?
  metadata    Json?
  contentIds  String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("Tag")
  @@index([name])
}

model UserEvent {
  id         String             @id @default(cuid())
  eventType  String
  type       UserEventActorType
  userId     String
  metadata   Json?
  payload    Json?
  context    Json?
  entityType String?
  entityId   String?
  createdAt  DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@index([type, createdAt])
  @@index([entityType, entityId])
}

model EventTypeStatistic {
  id        String   @id @default(cuid())
  eventType String   @unique
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Credit {
  id            String            @id @default(cuid())
  name          String
  metadata      Json?
  contentTypes  ContentType[]     @default([])
  creditLives   CreditLifeTime[]
  userCredits   UserCredit[]
  userTimed     UserCreditTimed[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([name])
}

model CreditLifeTime {
  id        String   @id @default(cuid())
  creditsId String
  name      String
  metadata  Json?
  lifeTime  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  credit Credit @relation(fields: [creditsId], references: [id], onDelete: Cascade)

  @@index([creditsId, createdAt])
}

model UserCredit {
  id        String   @id @default(cuid())
  creditsId String
  userId    String
  value     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  credit Credit @relation(fields: [creditsId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([creditsId, userId])
  @@index([userId, createdAt])
}

model UserCreditTimed {
  id        String    @id @default(cuid())
  creditsId String
  userId    String
  value     Int
  total     Int
  lifeTime  Int
  startedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  credit Credit @relation(fields: [creditsId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, creditsId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expires])
}
